# Skill change worktrees (per using-git-worktrees skill)
.worktrees/
# distill-memory.ps1 output (regenerated each run; syncthing still syncs to other PCs)
agent-memory/distilled/

# 3-tier skill structure: only self-designed skills/ is git-tracked.
# vendor/active/   = marketplace skills we use frequently (synced via syncthing, not git)
# vendor/archived/ = marketplace skills we don't use (synced via syncthing, not git)
# Promote archived -> active with: mv vendor/archived/<name> vendor/active/<name>
vendor/active/
vendor/archived/

# Stray template artifacts (unrendered {PROJECT_DIR} placeholders)
{PROJECT_DIR}/
skills/auto-dev/{PROJECT_DIR}/

# Reasonix cache folders (auto-generated)
.reasonix/
skills/.reasonix/

# Backups (auto-generated by various scripts)
backups/
.superpowers/

# Submodule bare repo stash (PC#1 only, syncthing excluded)
.git-remotes/
